# Arcane Eyes Configuration

# Network
SCAN_RANGE=192.168.1.0/24
RTSP_TRANSPORT=tcp
RTSP_TIMEOUT=5000000

# ONVIF
ONVIF_DEFAULT_USER=admin
ONVIF_DEFAULT_PASSWORD=
ONVIF_PORT=80

# Audio
# RTSP audio is preferred when a probed ONVIF stream includes audio.
# These settings are used only for the legacy raw TCP fallback path.
AUDIO_PORT=8001
AUDIO_FORMAT=mulaw
AUDIO_SAMPLE_RATE=8000
AUDIO_CHANNELS=1

# Storage
# SAVE_PATH=/custom/path/to/recordings
# CACHE_PATH=/custom/path/.eye_cache

# Setup QR credential cache
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SETUP_QR_FERNET_KEY=
# SETUP_QR_CREDENTIAL_CACHE_PATH=.setup_qr_credentials
